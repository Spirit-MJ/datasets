    // Check if two swaps are needed
    if (s[posA] == 'b' && s[posB] == 'a' && s[posC] == 'c') return true;
    if (s[posA] == 'c' && s[posB] == 'b' && s[posC] == 'a') return true;

    // Check if one swap can make it "abc"
    if ((s[posA] == 'b' && s[posB] == 'c' && s[posC] == 'a') ||
        (s[posA] == 'c' && s[posB] == 'a' && s[posC] == 'b')) {
        return true;
    }

    return false;
}

int main() {
    int t;
    cin >> t;

    for (int i = 0; i < t; ++i) {
        string s;
        cin >> s;
        if (canBeSortedByOneSwap(s)) {
            cout << "YES" << endl;
        } else {
            cout << "NO" << endl;
        }
    }

    return 0;
}
```

### Explanation

1. **Finding Positions**: We iterate through the string to find the positions of 'a', 'b', and 'c'.
2. **Initial Check**: If the string is already "abc", we return `true`.
3. **Two-Swap Check**: We check if swapping the first two positions (`a` and `b`) or the last two positions (`b` and `c`) can result in "abc".
4. **One-Swap Check**: We check if a single swap between any two pairs of characters can make the string "abc".

This approach ensures that we correctly identify if the string can be sorted with at most one swap.

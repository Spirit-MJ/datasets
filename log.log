point2 = (40.7128, -74.0060)  # New York City, NY, USA

distance, bearing = calculate_flight_path(point1, point2)
print(f"Distance: {distance:.2f} km")
print(f"Initial Bearing: {bearing:.2f} degrees")
```

### Step 3: Use Geodesic for More Accurate Distance Calculation
For more accuracy, especially over long distances, you can use the `geopy.distance.geodesic` method:

```python
def calculate_flight_path_geodesic(point1, point2):
    distance = geodesic(point1, point2).km
    # For bearing, geopy does not directly provide it, so we use the same formula as above
    lat1, lon1 = point1
    lat2, lon2 = point2
    dlon = lon2 - lon1
    dlat = lat2 - lat1
    a = np.sin(dlat/2)**2 + np.cos(lat1) * np.cos(lat2) * np.sin(dlon/2)**2
    c = 2 * np.arcsin(np.sqrt(a))
    initial_bearing = np.arctan2(np.cos(lat2) * np.sin(lon2 - lon1), 
                                 np.cos(lat1) * np.sin(lat2) - np.sin(lat1) * np.cos(lat2) * np.cos(lon2 - lon1))
    initial_bearing = np.degrees(initial_bearing)
    initial_bearing = (initial_bearing + 360) % 360  # Normalize to 0-360 degrees

    return distance, initial_bearing

# Example usage with geodesic
distance, bearing = calculate_flight_path_geodesic(point1, point2)
print(f"Distance: {distance:.2f} km")
print(f"Initial Bearing: {bearing:.2f} degrees")
```


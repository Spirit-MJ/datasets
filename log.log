</body>
</html>
```

### Step 3: Create the App Logic
Create a JavaScript file `app.js` to handle the logic.

```javascript
// app.js

async function loadModel() {
    const model = await transformers.loadTransformer('facebook/blenderbot-400m-distill');
    return model;
}

async function sendMessage(message) {
    const model = await loadModel();
    const response = await model.generate(message);
    return response[0];
}

document.getElementById('send-btn').addEventListener('click', async () => {
    const userInput = document.getElementById('user-input').value;
    if (userInput.trim() !== '') {
        document.getElementById('chat-window').innerHTML += `
            <div class="user-message">${userInput}</div>
            <div class="bot-message" style="margin-top: 10px;">${await sendMessage(userInput)}</div>
        `;
        document.getElementById('user-input').value = '';
    }
});

// Initial chat window
document.getElementById('chat-window').innerHTML += `
    <div class="bot-message">Hello! How can I assist you today?</div>
`;
```

### Step 4: Styling
Add some basic styling to make the chat app look nicer.


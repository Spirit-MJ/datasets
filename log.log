async def on_message(room, event):
    # Check if the event is a message and if it mentions the bot
    if event.sender != client.user_id and event.type == RoomMessageText:
        text = event.body.strip()
        if f"@{client.user_id}" in text:
            await client.room_send(
                room_id=room.room_id,
                message_type="m.room.message",
                content={
                    "msgtype": "m.text",
                    "body": f"Hello! You mentioned me in {room.display_name}.",
                },
            )
            print(f"Responded in room {room.room_id} to mention in {room.display_name}")

async def main():

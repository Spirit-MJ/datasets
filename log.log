import os
import matrix_nio
from matrix_nio import AsyncClient, RoomMessageText

# Configuration
HOMESERVER_URL = "https://matrix.org"  # Replace with your homeserver URL
ACCESS_TOKEN = "your_access_token"     # Replace with your access token

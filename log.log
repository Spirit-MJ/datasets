```javascript
function calculatePi(numSamples) {
    let insideCircle = 0;

    for (let i = 0; i < numSamples; i++) {
        const x = Math.random();  // Random x coordinate between 0 and 1
        const y = Math.random();  // Random y coordinate between 0 and 1

        // Check if the point (x, y) is inside the unit circle
        if (x * x + y * y <= 1) {
            insideCircle++;
        }
    }

    // The ratio of points inside the circle to the total number of points approximates π/4
    const pi = 4 * (insideCircle / numSamples);
    return pi;

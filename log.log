```python
import chess.engine

def main():
    board = chess.Board()
    print(board.unicode())

    engine = chess.engine.SimpleEngine.popen_uci("/path/to/stockfish")
    engine.configure({"UCI_Lookout": 2})

    while not board.is_game_over():
        print("\nYour move (input coordinates like 'e2e4' or 'e2e5'): ")

import os
import zipfile

def archive_files(src_folder):
    # Ensure the source folder exists
    if not os.path.exists(src_folder):
        print(f"Error: The directory {src_folder} does not exist.")
        return

    # Ensure the output folder exists
    output_folder = os.path.join(src_folder, "archived_files")
    if not os.path.exists(output_folder):
        os.makedirs(output_folder)

    # Get all files in the source folder
    files = [os.path.join(root, file) for root, _, files in os.walk(src_folder) for file in files]

    for file_path in files:
        # Create a unique zip file name
        zip_file_path = os.path.join(output_folder, os.path.basename(file_path) + '.zip')
        
        # Create a ZipFile object
        with zipfile.ZipFile(zip_file_path, 'w') as zipf:
            # Add the file to the zip archive
            zipf.write(file_path, arcname=os.path.basename(file_path))
        
        print(f"Zipped {file_path} as {zip_file_path}")

if __name__ == "__main__":
    src_folder = input("Enter the source folder path: ")
    archive_files(src_folder)
```


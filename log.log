            for p in path[:-1]:
                if rule != "if ":
                    rule += " and "
                rule += str(p)
            rule += " then "
            if class_names is None:
                rule += "response: " + str(np.round(path[-1][0][0][0], 3))
            else:
                classes = path[-1][0][0]
                l = np.argmax(classes)
                rule += f"class: {class_names[l]} (proba: {np.round(100.0*classes[l]/np.sum(classes),2)}%)"
            rule += f" | based on {path[-1][1]:,} samples"
            rules += [rule]

        return rules

    model = joblib.load("des_tree_clss.joblib")
    rule_list = get_rules(model, predictions_df.columns, range(2))
    rule_df = pd.DataFrame(
        rule_list, columns=["rule_details", "class_probabilities", "samples_count"]
    )

    # Define the callback function for click events
    def on_click(trace, points, state):
        row = df_combined.iloc[points.point_inds[0]]
        for rule in rule_list:
            if all([feature in rule for feature in row.index if feature != "Synthetic_Timestamp" and feature != "Predicted_Status"]):
                st.write(rule)
                break

    fig.update_traces(
        clickmode="event+select",
        clickfun=lambda trace, points, state: on_click(trace, points, state)
    )

    # Display the plot
    st.plotly_chart(fig)

    # Create a download link
    st.subheader("Download the File with Predictions:")
    st.write("Download the File with Predictions:")

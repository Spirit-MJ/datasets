#include <stdio.h>
#include <string.h>

int main() {
    int T;
    scanf("%d", &T);

    while (T--) {
        int N;
        scanf("%d", &N);
        char S[N + 1];
        scanf("%s", S);

        int fair = 1;

        // Check if the first half is always less than or equal to the second half
        for (int i = 0; i < N / 2; i++) {
            if (S[i] == '1' && S[i + N / 2] == '1') {
                fair = 0;
                break;
            }
            if (S[i] == '1' && S[i + N / 2] == '0') {
                fair = 0;
                break;
            }
        }

        // Check if the second half is always less than or equal to the first half
        for (int i = N / 2; i < N; i++) {
            if (S[i] == '1' && S[i - N / 2] == '1') {
                fair = 0;
                break;
            }
            if (S[i] == '1' && S[i - N / 2] == '0') {
                fair = 0;
                break;
            }
        }

        if (fair) {
            printf("YES\n");
        } else {
            printf("NO\n");
        }
    }

    return 0;
}
```


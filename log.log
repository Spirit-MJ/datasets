      </div>
    </div>
    <button id="send-button" class="button is-primary">Send</button>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@3.10.0/dist/tf.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs-node@3.10.0/dist/tf.node.min.js"></script>

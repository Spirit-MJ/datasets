#include <stdio.h>
#include <string.h>

int main() {
    int T;
    scanf("%d", &T);
    
    while (T--) {
        int N;
        scanf("%d", &N);
        
        char S[N + 1];
        scanf("%s", S);
        
        // Count the number of 1's and 0's in the string
        int ones = 0, zeros = 0;

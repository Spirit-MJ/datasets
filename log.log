```python
import numpy as np

class ContextualMultiArmedBandit:
    def __init__(self, num_arms=3, num_contexts=2):
        """
        Initialize the Contextual Multi-Armed Bandit.
        
        :param num_arms: Number of arms (models) in the bandit.
        :param num_contexts: Number of contexts available.
        """
        self.num_arms = num_arms
        self.num_contexts = num_contexts
        self.contexts = np.random.rand(num_contexts)
        self.successes = np.zeros((num_contexts, num_arms))
        self.failures = np.zeros((num_contexts, num_arms))
        selfArm_counts = np.zeros((num_contexts, num_arms))
        self.alpha = 1.0  # Hyperparameter for the Beta distribution

    def sample_arms(self, context):
        """
        Sample an arm (model) based on the given context using Thompson Sampling.
        
        :param context: The current context index.
        :return: The index of the sampled arm.
        """
        if context >= self.num_contexts:
            raise ValueError(f"Context index {context} out of range. Should be in the range [0, {self.num_contexts - 1}].")
        
        # Thompson Sampling: Sample from the posterior Beta distribution
        sampled_arms = np.random.beta(self.successes[context] + self.alpha, self.failures[context] + self.alpha)
        
        # Return the arm with the highest sample
        return np.argmax(sampled_arms)

    def update_arms(self, context, arm, reward):
        """
        Update the success and failure counts for the given arm based on the reward.
        
        :param context: The current context index.
        :param arm: The index of the sampled arm.
        :param reward: The reward obtained for the sampled arm.
        """
        if context >= self.num_contexts:
            raise ValueError(f"Context index {context} out of range. Should be in the range [0, {self.num_contexts - 1}].")
        
        if arm >= self.num_arms:
            raise ValueError(f"Arm index {arm} out of range. Should be in the range [0, {self.num_arms - 1}].")
        
        if reward == 1:
            self.successes[context, arm] += 1
        else:
            self.failures[context, arm] += 1

    def run_simulation(self, num_steps):
        """
        Run a simulation for a given number of steps.
        
        :param num_steps: Number of steps to run the simulation.
        """
        rewards = []
        for _ in range(num_steps):
            context = np.random.randint(self.num_contexts)
            arm = self.sample_arms(context)
            reward = np.random.choice([0, 1], p=[0.3, 0.7])  # Simulated reward based on context and arm
            self.update_arms(context, arm, reward)
            rewards.append(reward)
        
        return rewards

# Example usage

\[
\rho_2 = \frac{1}{3} \left( \ket{0} \bra{0} + \ket{0} \bra{0} + \ket{0} \bra{0} \right) = \frac{1}{3} \cdot 3 \ket{0} \bra{0} = \ket{0} \bra{0}

    def explain_prediction(idx):
        if idx in rules_data.keys():
            df_explain = df_combined[df_combined.index == idx]
            explainer = lime.lime_tabular.LimeTabularExplainer(
                df_combined.drop("Synthetic_Timestamp", axis=1).values,
                feature_names=df_combined.drop("Synthetic_Timestamp", axis=1).columns,
                class_names=["0", "1"],
                mode="classification"
            )
            exp = explainer.explain_instance(df_explain.values[0], model.predict_proba, num_features=5)
            st.write(exp.as_list())
        else:

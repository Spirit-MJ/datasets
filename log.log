  <script src="src/chat.js"></script>
</body>
</html>
```

#### 4. `chat.js` (in `src`)
```javascript
import { loadModel, ModelType, Tokenizer } from 'transformers.js';
import axios from 'axios';

// Load the model
const model = await loadModel('facebook/blenderbot-400M-distill', ModelType.TF2);

// Initialize tokenizer
const tokenizer = new Tokenizer('facebook/blenderbot-400M-distill');

const chatMessages = document.getElementById('chat-messages');
const userInput = document.getElementById('user-input');
const sendButton = document.getElementById('send-button');

// Function to handle user input and generate model response
async function handleChat() {
  const userMessage = userInput.value.trim();
  if (userMessage) {
    // Append user message to chat
    const userMessageElement = document.createElement('div');
    userMessageElement.classList.add('message', 'is-primary');
    userMessageElement.textContent = userMessage;
    chatMessages.appendChild(userMessageElement);
    userInput.value = '';

    // Generate model response
    const inputIds = tokenizer.encode(userMessage, { truncation: true, padding: 'max_length', max_length: 128 });
    const result = await model.infer(inputIds);
    const response = tokenizer.decode(result.logits, { skip_special_tokens: true });

    // Append model response to chat
    const responseElement = document.createElement('div');
    responseElement.classList.add('message', 'is-secondary');
    responseElement.textContent = response;
    chatMessages.appendChild(responseElement);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }
}

// Event listeners
sendButton.addEventListener('click', handleChat);
userInput.addEventListener('keypress', (event) => {
  if (event.key === 'Enter') {
    event.preventDefault();
    handleChat();
  }
});
```

#### 5. `index.js` (in `src`)
```javascript
import './chat.js';
```


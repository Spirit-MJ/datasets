        // Perform the second XOR operation
        byte[] secondXOR = firstXOR.Select((byte i, int index) => i ^ index).ToArray();

        // Convert the final byte array to a string for display
        string result = System.Text.Encoding.UTF8.GetString(secondXOR);

        // Print the result

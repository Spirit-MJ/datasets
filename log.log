Sure! To create a DVD screen saver logo that bounces around the screen and tallies points when it touches the corner, you can use Python with the `tkinter` library. Below is a script to achieve this:

```python
import tkinter as tk
import random

class BouncingLogo:
    def __init__(self, root, canvas, logo):
        self.root = root
        self.canvas = canvas
        self.logo = logo
        self.speed_x = random.choice([-5, 5])
        self.speed_y = random.choice([-5, 5])
        self.points = 0

    def draw(self):
        self.canvas.delete("logo")
        self.canvas.create_image(self.logo.x, self.logo.y, image=self.logo.img, tag="logo")

    def move(self):
        self.logo.x += self.speed_x
        self.logo.y += self.speed_y

        if self.logo.x <= 0 or self.logo.x >= self.canvas.winfo_width() - self.logo.size:
            self.speed_x = -self.speed_x
        if self.logo.y <= 0 or self.logo.y >= self.canvas.winfo_height() - self.logo.size:
            self.speed_y = -self.speed_y

        if self.logo.x <= 0 and self.logo.y <= 0:
            self.points += 1
            self.show_points()
        elif self.logo.x <= 0 and self.logo.y >= self.canvas.winfo_height() - self.logo.size:
            self.points += 1
            self.show_points()
        elif self.logo.x >= self.canvas.winfo_width() - self.logo.size and self.logo.y <= 0:
            self.points += 1
            self.show_points()
        elif self.logo.x >= self.canvas.winfo_width() - self.logo.size and self.logo.y >= self.canvas.winfo_height() - self.logo.size:
            self.points += 1
            self.show_points()

        self.draw()

    def show_points(self):
        self.canvas.delete("points")
        self.canvas.create_text(self.canvas.winfo_width() // 2, 20, text=f"Points: {self.points}", fill="white", font=("Arial", 20), tag="points")

    def run(self):
        self.draw()
        self.move()
        self.root.after(10, self.run)

class Logo:
    def __init__(self, x, y, size, img):
        self.x = x
        self.y = y
        self.size = size
        self.img = img

def main():
    root = tk.Tk()
    root.title("DVD Screen Saver Logo Bounce")
    root.geometry("800x600")
    root.resizable(False, False)
    root.config(bg="black")

    canvas = tk.Canvas(root, width=800, height=600, bg="black")
    canvas.pack()

    # Load your logo image
    try:
        logo = Logo(400, 300, 50, tk.PhotoImage(file="logo.png"))  # Replace "logo.png" with your logo file
    except Exception as e:
        print(f"Error loading logo: {e}")
        return

    screen_saver = BouncingLogo(root, canvas, logo)
    screen_saver.run()

    root.mainloop()

if __name__ == "__main__":
    main()
```

### Instructions:
1. Save the script to a file, for example, `dvd_screensaver.py`.

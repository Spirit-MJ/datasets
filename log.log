```python
from gluonts.evaluation import quantile_mae, quantile_rmse, quantile_loss

# Calculate MSE, RMSE, and MAE
def calculate_metrics(forecasts, timeseries):
    agg_mae = 0
    agg_rmse = 0
    agg_mse = 0
    count = 0

    for forecast, ts in zip(forecasts, timeseries):
        actual = ts.values
        forecast_vals = forecast.samples.mean(axis=0)

        # Mean Squared Error (MSE)
        mse = np.mean((forecast_vals - actual) ** 2)
        agg_mse += mse
        count += 1

        # Root Mean Squared Error (RMSE)
        rmse = np.sqrt(mse)
        agg_rmse += rmse

        # Mean Absolute Error (MAE)
        mae = np.mean(np.abs(forecast_vals - actual))
        agg_mae += mae

    # Compute average values
    agg_mse /= count
    agg_rmse /= count
    agg_mae /= count
    
    return agg_mse, agg_rmse, agg_mae


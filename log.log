        self.context_dim = context_dim
        self.models = [Model(f"Model_{i+1}", np.random.randn(context_dim)) for i in range(num_arms)]
        self.context = np.random.randn(context_dim)  # Example context

    def choose_arm(self, context):
        # Thompson Sampling: Choose the arm with the highest expected reward
        samples = np.array([model.samples for model in self.models])
        arm_indices = np.argmax(samples, axis=0)
        return np.random.choice(arm_indices)

    def update(self, chosen_arm, reward):
        # Update the model with the observed reward
        self.models[chosen_arm].rewards.append(reward)

    def simulate(self, num_steps):
        rewards = []
